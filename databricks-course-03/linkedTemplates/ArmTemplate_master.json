{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "databricks-course-03"
		},
		"AzureDatabricks1_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'AzureDatabricks1'"
		},
		"ls_movie_history_adls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_movie_history_adls'"
		},
		"AzureDatabricks1_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0505-221435-eolru55u"
		},
		"ls_movie_history_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://moviehistory05.dfs.core.windows.net/"
		},
		"tg_proccess_movie_properties_pl_master_process_movie_parameters_p_enviroment": {
			"type": "string",
			"defaultValue": "producction"
		},
		"tg_proccess_movie_properties_pl_master_process_movie_parameters_p_file_date": {
			"type": "string",
			"defaultValue": "2024-12-27"
		},
		"tg_proccess_movie_history_properties_pl_master_process_movie_parameters_p_enviroment": {
			"type": "string",
			"defaultValue": "production"
		},
		"tg_proccess_movie_history_properties_pl_master_process_movie_parameters_p_file_date": {
			"type": "string",
			"defaultValue": "2024-12-30"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "databricks-course-03_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDatabricks1_accessToken": {
						"value": "[parameters('AzureDatabricks1_accessToken')]"
					},
					"ls_movie_history_adls_accountKey": {
						"value": "[parameters('ls_movie_history_adls_accountKey')]"
					},
					"AzureDatabricks1_properties_typeProperties_existingClusterId": {
						"value": "[parameters('AzureDatabricks1_properties_typeProperties_existingClusterId')]"
					},
					"ls_movie_history_adls_properties_typeProperties_url": {
						"value": "[parameters('ls_movie_history_adls_properties_typeProperties_url')]"
					},
					"tg_proccess_movie_properties_pl_master_process_movie_parameters_p_enviroment": {
						"value": "[parameters('tg_proccess_movie_properties_pl_master_process_movie_parameters_p_enviroment')]"
					},
					"tg_proccess_movie_properties_pl_master_process_movie_parameters_p_file_date": {
						"value": "[parameters('tg_proccess_movie_properties_pl_master_process_movie_parameters_p_file_date')]"
					},
					"tg_proccess_movie_history_properties_pl_master_process_movie_parameters_p_enviroment": {
						"value": "[parameters('tg_proccess_movie_history_properties_pl_master_process_movie_parameters_p_enviroment')]"
					},
					"tg_proccess_movie_history_properties_pl_master_process_movie_parameters_p_file_date": {
						"value": "[parameters('tg_proccess_movie_history_properties_pl_master_process_movie_parameters_p_file_date')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}